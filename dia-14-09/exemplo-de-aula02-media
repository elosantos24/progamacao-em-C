#include <stdio.h>

int main()
{
    float nota1, nota2, media;
    
    printf("Digite a sua primeira nota: ");
    scanf("%f", &nota1);
    printf("Digite a sua segunda nota: ");
    scanf("%f", &nota2);
    
    media = (nota1+nota2)/2.0f;
    
    if(media>=6){
        printf("\n Parabéns, você foi aprovado! com a média de %2.f", media);
    }
    else{
        printf("\n Infelizmente você não conseguiu atingir a média!");
    }

